# PostgreSQL — local or RDS
# Always quote DATABASE_URL — query strings contain & which breaks unquoted shell/PM2 sourcing.
# Production (shared TradeKo/EOG RDS, dedicated DB). sslmode + uselibpqcompat required on RDS:
# DATABASE_URL="postgresql://USER:PASSWORD@tradeko.chssuuoa2xdc.ap-southeast-1.rds.amazonaws.com:5432/gamepassid?schema=public&sslmode=require&uselibpqcompat=true"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamepassid?schema=public"

# Encoder session signing (required in production — long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Production listen (PM2 / ecosystem.config.cjs uses 3210 on the shared EC2)
PORT=3210
NODE_ENV=development
